# Node
node_modules/
npm-debug.log*

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.venv/
venv/

# Cloudflare Worker
worker-template/.wrangler/
worker-template/.dev.vars
worker-template/wrangler.toml

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Build artifacts
dist/
build/

# Secrets — never commit
.env
.env.local
secrets.json
*turso*token*
*.secret

# Headless extension test artifacts
tests/.tmp-chrome-profile/

# Dev daemon local state
python-dev-daemon/bridge.db
python-dev-daemon/bridge.db-journal

# Backend session files (contain live credentials — never commit)
backend/sessions/*
!backend/sessions/example.json

# Onboard API runtime state — the .db itself IS committed deliberately:
# git is the durable disk (operator policy, see handoff / SKILL.md §4);
# the DB holds the credential store that must survive sandbox recycles.
# Transient SQLite files stay local; run `PRAGMA wal_checkpoint(TRUNCATE)`
# before committing so onboard.db is self-contained.
backend/api/data/*.db-wal
backend/api/data/*.db-shm
backend/api/data/api.log
backend/api/data/api.pid
backend/api/data/warm_creds_*.json

# E2E rotation state (runtime)
backend/e2e_state.json

# Next.js build artifacts in web/
web/.next/
web/next-env.d.ts
